# 실제 값은 storeops_ai/.env 파일에만 채우세요. 이 파일은 예시용 템플릿입니다.

# 사건이 발생했을 때 StoreOpsAI 백엔드의 내부 사건 수신 API로 즉시 전송합니다.
# 백엔드와 storeops_ai를 같은 PC에서 실행하면 backend 포트(8000)와 겹치지 않도록
# storeops_ai는 --port 8001로 실행하는 것을 권장합니다.
ALERT_WEBHOOK_URL=http://localhost:8000/api/internal/events

# 위 웹훅 호출 시 Authorization: Bearer 헤더로 보내는 토큰입니다.
# 백엔드의 STOREOPS_AI_INGEST_TOKENS_JSON에 같은 토큰과 매장 번호를 등록해야 합니다.
EVENT_INGEST_TOKEN=change-me-token

# 사건 영상은 storeops_ai가 저장한 경로 그대로 백엔드에 전달되고, 백엔드가 output 폴더를
# 공유 볼륨으로 마운트해 /api/events/{event_id}/clip 로 점주 세션 인증 후 직접 서빙합니다.

