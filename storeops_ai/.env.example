# 실제 값은 storeops_ai/.env 파일에만 채우세요. 이 파일은 예시용 템플릿입니다(.env는 저장소에 올리지 않습니다).
# 도커(compose)로 실행하면 compose가 이 파일을 읽고, python으로 직접 실행하면 config가 직접 읽습니다.
# 셸에 이미 설정된 환경변수가 있으면 그 값이 우선합니다.

# ---- 백엔드 연결 (카메라 컴퓨터 → 백엔드 컴퓨터) ----
# 사건이 났을 때 백엔드의 내부 사건 수신 API로 1회 전송합니다. <백엔드>는 백엔드 컴퓨터의 주소입니다.
ALERT_WEBHOOK_URL=http://<백엔드 주소>:8000/api/internal/events
VLM_RESULT_WEBHOOK_URL=http://<백엔드 주소>:8000/api/internal/events/{event_id}/vlm

# 위 전송 때 Authorization: Bearer 헤더로 보내는 비밀 토큰입니다(직접 만든 랜덤 문자열).
# 백엔드의 STOREOPS_AI_INGEST_TOKENS_JSON에 {"이 토큰": "S01"} 형태로 같은 값을 등록해야 합니다.
EVENT_INGEST_TOKEN=change-me-token

# ---- 클립·대표 이미지 저장 위치 ----
# 백엔드 컴퓨터의 공유 폴더(백엔드의 STOREOPS_OUTPUT_DIR / compose의 STOREOPS_OUTPUT_HOST_DIR과 같은 폴더).
# 비우면 이 컴퓨터의 storeops_ai/output에 저장합니다(백엔드와 같은 컴퓨터일 때).
# 공유 폴더 로그인 정보는 여기에 넣지 말고 윈도우 자격 증명 관리자에 저장하세요.
STOREOPS_OUTPUT_DIR=

# ---- 동작 ----
# 1이면 사건 시점에 VLM이 대표 이미지를 읽습니다(기본 0: 질문 시점에만 백엔드가 VLM을 부름).
VLM_ON_EVENT=0
# 실시간 웹캠 모드에서 같은 비정상 클래스를 몇 번 연속 확인해야 사건으로 확정할지(기본 1 = 즉시).
CONFIRMATIONS_REQUIRED=1

# ---- VLM (VLM_ON_EVENT=1일 때만 사용) ----
QWEN_VLM_BASE_URL=
QWEN_VLM_MODEL=Qwen/Qwen3-VL-8B-Instruct-FP8
QWEN_VLM_API_KEY=
QWEN_VLM_TIMEOUT_SEC=60
QWEN_VLM_MAX_TOKENS=512
QWEN_VLM_IMAGE_MAX_PIXELS=147456
QWEN_VLM_IMAGE_JPEG_QUALITY=85
