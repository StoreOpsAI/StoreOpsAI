# Docker Compose로 실행할 때 사용하는 예시입니다.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=storeops
POSTGRES_USER=storeops
POSTGRES_PASSWORD=storeops_dev_password
DATABASE_URL=postgresql://storeops:storeops_dev_password@postgres:5432/storeops
FRONTEND_ORIGIN=http://localhost:5173

# storeops_ai가 /api/internal/events로 사건을 보낼 때 쓰는 Bearer 토큰과 매장 번호 매핑입니다.
# 키는 storeops_ai의 EVENT_INGEST_TOKEN 값과 반드시 같아야 합니다.
STOREOPS_AI_INGEST_TOKENS_JSON={"change-me-token":"S01"}
